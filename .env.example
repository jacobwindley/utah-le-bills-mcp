# Copy to .env and fill in. .env is git-ignored.

# Developer token from https://le.utah.gov/data/developer.htm ("Get my developer token").
# Optional: enables Utah Code, Constitution, legislative rules, and meeting-agenda tools.
LE_UTAH_TOKEN=

# Default per-response character budget for tool output (hard cap 20000).
# LE_MAX_RESPONSE_CHARS=4000

# Optional: a directory to save the bill search index in, so it survives restarts
# (about 1.2 MB per session). Unset = memory only; nothing is written to disk.
# LE_CACHE_DIR=~/.cache/le-bills-mcp
